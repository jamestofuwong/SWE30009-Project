{
  "name": "ai-gateway-usage",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/api",
    "pretest:selenium": "[ -x tests/.venv/bin/python ] || (python3 -m venv tests/.venv && tests/.venv/bin/pip install -q -r tests/requirements.txt)",
    "test:selenium": "tests/.venv/bin/python tests/run_tests.py"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
